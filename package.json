{
  "name": "stocksense-ai",
  "private": true,
  "version": "1.0.0",
  "description": "StockSense AI - voice-driven inventory, sales and profit analytics for small businesses (Android APK + web/PWA)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --trace off",
    "eval": "vite-node scripts/run-eval.ts",
    "demo:samples": "vite-node scripts/generate-demo-data.ts",
    "fixtures": "vite-node scripts/generate-fixtures.ts",
    "screenshots": "playwright test --config playwright.screens.config.ts --trace off",
    "cap:sync": "cap sync android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-speech-recognition": "8.5.1",
    "comlink": "4.4.2",
    "echarts": "6.1.0",
    "lucide-react": "1.73.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sql.js": "1.16.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-node": "^5.0.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
