<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules: same exclusion as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
